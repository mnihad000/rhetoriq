# Use this only as a local Compose template. Put real secrets in Railway.
POSTGRES_DB=rhetoriq
POSTGRES_USER=rhetoriq
POSTGRES_PASSWORD=change-this-for-local-only
GEMINI_API_KEY=
GROQ_API_KEY=
SEARXNG_SECRET=replace-with-a-long-random-secret
VITE_API_BASE_URL=http://localhost:8000
REQUEST_RATE_LIMIT_PER_MINUTE=120
INVESTIGATION_START_LIMIT_PER_HOUR=5
REQUEST_RATE_LIMIT_MAX_CLIENTS=10000
# Keep false unless every request reaches the API through a trusted proxy.
TRUST_PROXY_HEADERS=false
# Durable database-backed worker queue settings.
JOB_POLL_SECONDS=0.5
JOB_LEASE_SECONDS=60
JOB_LEASE_RENEW_SECONDS=15
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=1
# B5 overlay: activate retrieval only after runtime acceptance and corpus backfill.
ENABLE_B5_RETRIEVAL=false
ELASTICSEARCH_PASSWORD=replace-with-local-elasticsearch-secret
NEO4J_PASSWORD=replace-with-local-neo4j-secret
REDIS_PASSWORD=replace-with-local-redis-secret
