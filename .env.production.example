# Use this only as a local Compose template. Put real secrets in Railway.
POSTGRES_DB=rhetoriq
POSTGRES_USER=rhetoriq
POSTGRES_PASSWORD=change-this-for-local-only
GEMINI_API_KEY=
GROQ_API_KEY=
SEARXNG_SECRET=replace-with-a-long-random-secret
VITE_API_BASE_URL=http://localhost:8000
REQUEST_RATE_LIMIT_PER_MINUTE=120
INVESTIGATION_START_LIMIT_PER_HOUR=5
REQUEST_RATE_LIMIT_MAX_CLIENTS=10000
# Keep false unless every request reaches the API through a trusted proxy.
TRUST_PROXY_HEADERS=false
# Keep the legacy feed until all B4 stabilization gates pass.
ENABLE_FLINK_TRENDING=false
FLINK_AUTO_INVESTIGATE=false
# Hosted enrichment startup requires explicit positive budgets. These zeros
# intentionally prevent inference until the operator configures the limits.
ENRICHMENT_REQUEST_BUDGET=0
ENRICHMENT_SPEND_BUDGET_MICROS=0
# Explicit micro-USD per million token rate ceilings. Cover both extraction
# models at current provider prices; input byte count bounds token count.
ENRICHMENT_INPUT_PRICE_MICROS_PER_MILLION=0
ENRICHMENT_OUTPUT_PRICE_MICROS_PER_MILLION=0
ENRICHMENT_EMBEDDING_PRICE_MICROS_PER_MILLION=0
